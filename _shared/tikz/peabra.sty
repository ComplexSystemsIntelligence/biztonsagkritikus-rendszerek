% peabra.sty -- közös TikZ-stílus a Pannon Egyetem nyílt tankönyvsorozatához
% (Rendszermérnökség, Biztonságkritikus rendszerek, ...).
% Pannon Egyetem-arculathoz illeszkedő színek és betűk.
% Minden ábra önálló standalone dokumentum, amely ezt a csomagot tölti be.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{peabra}[2026/11/20 PE abrastilus]

\RequirePackage{fontspec}
% A betűket családnévvel töltjük be: XeLaTeX és LuaLaTeX alatt is működik,
% ha a _shared/fonts/ttf betűk telepítve vannak (pl. ~/.fonts).
\setmainfont{IBM Plex Sans}[BoldFont={IBM Plex Sans SemiBold},
  ItalicFont={IBM Plex Sans Italic}, BoldItalicFont={IBM Plex Sans Bold Italic}]
\setsansfont{IBM Plex Sans}[BoldFont={IBM Plex Sans SemiBold},
  ItalicFont={IBM Plex Sans Italic}, BoldItalicFont={IBM Plex Sans Bold Italic}]
\setmonofont{IBM Plex Mono}[Scale=0.9]
\newfontfamily\cimbetu{Raleway ExtraBold}[BoldFont={Raleway Black}]
\RequirePackage{amsmath}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18, /pgf/number format/use comma, /pgf/number format/1000 sep={\,}, /pgf/number format/min exponent for 1000 sep=4}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,shapes.misc,
  shapes.gates.logic.US,shapes.arrows,shapes.symbols,backgrounds,fit,
  decorations.pathreplacing,decorations.pathmorphing,matrix,patterns,trees}
\usepgfplotslibrary{fillbetween}

% --- Színpaletta (a sorozatban egységes) -----------------------------
\definecolor{peKek}{HTML}{285780}      % PE elsődleges kék
\definecolor{peSotet}{HTML}{1B3A57}    % sötét változat
\definecolor{peKozep}{HTML}{4F7FAD}    % középkék
\definecolor{peVilagos}{HTML}{A9C4DE}  % világoskék
\definecolor{peHalvany}{HTML}{E6EEF6}  % háttérárnyalat
\definecolor{peKiemel}{HTML}{E07B39}   % kiemelés (narancs)
\definecolor{peKiemelH}{HTML}{FBE7D9}  % halvány narancs
\definecolor{peZold}{HTML}{3E8E63}     % ellenőrzés, siker, biztonságos állapot
\definecolor{peZoldH}{HTML}{DDEFE4}
\definecolor{pePiros}{HTML}{B83A3A}    % kockázat, hiba, veszélyes állapot
\definecolor{pePirosH}{HTML}{F6DEDE}
\definecolor{peLila}{HTML}{7A5C99}
\definecolor{peLilaH}{HTML}{ECE5F3}
\definecolor{peSarga}{HTML}{D9A520}    % átmeneti (ALARP) tartomány
\definecolor{peSargaH}{HTML}{FAF0D2}
\definecolor{peSzurke}{HTML}{6B7280}
\definecolor{peSzurkeH}{HTML}{F1F2F4}
\definecolor{peSzoveg}{HTML}{1F2933}
% Esettanulmány-színek (betűjelhez kötve, a sorozatban azonos)
\colorlet{esetA}{peKek}     % ReaktorVéd -- folyamatipari védelmi rendszer
\colorlet{esetB}{peZold}    % VészFék -- vészfékező asszisztens és fékrendszer
\colorlet{esetC}{peLila}    % KoboCella -- kollaboratív robotcella

